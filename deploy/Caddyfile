{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

# Redirection HTTP → HTTPS automatique ; certificat Let's Encrypt émis et renouvelé par Caddy.
{$KNOWLIST_DOMAIN} {
	encode zstd gzip

	tls {
		protocols tls1.2 tls1.3
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		X-Robots-Tag "noindex, nofollow, noarchive"
		-Server
	}

	# Pendant un redémarrage de l'application (déploiement), les requêtes patientent au lieu d'échouer.
	reverse_proxy app:3000 {
		lb_try_duration 20s
		lb_try_interval 250ms
		health_uri /healthz
		health_interval 10s
	}

	log {
		output stdout
		format json
	}
}
